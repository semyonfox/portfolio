---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('games')).sort(
  (a, b) => a.data.order - b.data.order,
);

const gamePreviewClass: Record<string, string> = {
  'space-invaders': 'game-thumb--space-invaders',
  'maze-chase': 'game-thumb--maze-chase',
  'game-of-life': 'game-thumb--game-of-life',
  artificial: 'game-thumb--artificial',
  'cellular-caves': 'game-thumb--cellular-caves',
  'gacha-bot': 'game-thumb--gacha-bot',
  'clicker-game': 'game-thumb--clicker-game',
};
---

<Layout
  title="Games | Semyon Fox"
  description="Games and apps I've built that you can actually play."
>
  <section class="pt-20 pb-16 md:pt-28">
    <div id="games-intro">
      <h1 class="type-page-title mb-3">Games & Apps</h1>
      <p class="type-body mb-12">
        games and other interactive things i've built
      </p>
    </div>

    <!-- catalog grid -->
    <div
      id="game-catalog"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"
    >
      {
        games.map((game) => (
          <button
            class="game-card bg-surface border border-heading/[0.06] rounded-bento overflow-hidden hover:border-heading/10 transition-colors text-left group"
            data-game-id={game.id}
            data-game-title={game.data.title}
            data-game-description={game.data.description}
            data-game-tech={game.data.tech}
            data-game-github={game.data.private ? '' : game.data.github || ''}
            data-game-private={game.data.private ? 'true' : 'false'}
            data-game-embed={game.data.embed || ''}
            data-game-noembed={game.data.noEmbed || ''}
            data-game-download={game.data.download || ''}
            data-game-display-width={game.data.displayWidth || ''}
            data-game-display-height={game.data.displayHeight || ''}
          >
            {game.data.thumbnail ? (
              <img
                src={game.data.thumbnail}
                alt=""
                width="960"
                height="540"
                class="w-full h-36 md:h-44 object-cover border-b border-border"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class:list={[
                  'game-thumb',
                  gamePreviewClass[game.id] || 'game-thumb--default',
                ]}
                aria-hidden="true"
              >
                <span class="game-thumb-screen" />
              </div>
            )}
            <div class="p-4">
              <h3 class="type-small-title group-hover:text-fox/90 transition-colors">
                {game.data.title}
              </h3>
              <p class="text-muted text-sm mt-1.5 line-clamp-2 leading-relaxed">
                {game.data.description}
              </p>
              <p class="text-dim text-xs mt-2">{game.data.tech}</p>
            </div>
          </button>
        ))
      }
    </div>

    <!-- game player (hidden by default) -->
    <div id="game-player" class="hidden">
      <div
        class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4"
      >
        <div>
          <h2 id="player-title" tabindex="-1" class="type-section-title"></h2>
          <p id="player-tech" class="text-dim text-xs mt-1"></p>
        </div>
        <div class="player-actions flex flex-wrap items-center gap-2">
          <a
            id="player-github"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden border border-border text-muted text-xs px-3 py-1.5 rounded-lg hover:text-heading hover:border-muted transition-colors"
          >
            github
          </a>
          <a
            id="player-download"
            href="#"
            download
            class="hidden border border-border text-muted text-xs px-3 py-1.5 rounded-lg hover:text-heading hover:border-muted transition-colors"
          >
            <span id="player-download-label">download</span>
          </a>
          <span
            id="player-private"
            class="hidden border border-border text-muted text-xs px-3 py-1.5 rounded-lg"
          >
            private repo
          </span>
          <button
            id="player-fullscreen"
            class="border border-border text-muted text-xs px-3 py-1.5 rounded-lg hover:text-heading hover:border-muted transition-colors"
          >
            fullscreen
          </button>
          <button
            id="player-back"
            class="border border-border text-muted text-xs px-3 py-1.5 rounded-lg hover:text-heading hover:border-muted transition-colors"
          >
            back to games
          </button>
        </div>
      </div>
      <div id="player-stage" class="game-stage">
        <iframe
          id="player-frame"
          class="game-frame"
          allow="fullscreen"
          tabindex="0"
          title="Game player"></iframe>
      </div>
      <div id="player-details" class="player-details">
        <p id="player-description" class="type-body"></p>
        <p id="player-status" class="text-muted text-sm mt-3" role="status"></p>
        <div class="player-actions flex flex-wrap gap-3 mt-3">
          <button id="player-retry" class="hidden text-fox text-sm">retry player</button>
          <a id="player-direct" class="hidden text-fox text-sm" target="_blank" rel="noopener noreferrer">open in new tab &nearr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .game-thumb {
    position: relative;
    height: 9rem;
    overflow: hidden;
    border-bottom: 1px solid #252525;
    background: #1f1f1f;
    isolation: isolate;
  }

  @media (min-width: 48rem) {
    .game-thumb {
      height: 11rem;
    }
  }

  .game-thumb::before,
  .game-thumb::after,
  .game-thumb-screen {
    content: '';
    position: absolute;
    display: block;
  }

  .game-thumb-screen {
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 /
        100% 10px,
      radial-gradient(
        circle at 30% 20%,
        rgba(255, 255, 255, 0.08),
        transparent 18%
      ),
      linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.22));
    opacity: 0.7;
    pointer-events: none;
  }

  .game-thumb--space-invaders {
    background:
      radial-gradient(circle at 18% 24%, #f0f0f0 0 1px, transparent 1.5px),
      radial-gradient(circle at 64% 18%, #f0f0f0 0 1px, transparent 1.5px),
      radial-gradient(circle at 78% 56%, #f0f0f0 0 1px, transparent 1.5px),
      linear-gradient(180deg, #111827, #151515);
  }

  .game-thumb--space-invaders::before {
    width: 12px;
    height: 12px;
    left: 50%;
    top: 35%;
    translate: -50% -50%;
    background: #8fe6ff;
    box-shadow:
      -44px 0 0 #8fe6ff,
      44px 0 0 #8fe6ff,
      -22px 24px 0 #e8702a,
      22px 24px 0 #e8702a;
  }

  .game-thumb--space-invaders::after {
    width: 58px;
    height: 10px;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    background: #e8702a;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .game-thumb--maze-chase {
    background:
      linear-gradient(90deg, transparent 47%, #2f5cff 48% 52%, transparent 53%),
      linear-gradient(transparent 30%, #2f5cff 31% 35%, transparent 36%),
      linear-gradient(
        90deg,
        #2f5cff 8%,
        transparent 8% 28%,
        #2f5cff 28% 32%,
        transparent 32% 70%,
        #2f5cff 70% 74%,
        transparent 74%
      ),
      #111421;
  }

  .game-thumb--maze-chase::before {
    width: 18px;
    height: 18px;
    left: 28%;
    top: 56%;
    border-radius: 999px;
    background: #e8702a;
    box-shadow: 84px -42px 0 #8fe6ff;
  }

  .game-thumb--maze-chase::after {
    width: 42px;
    height: 4px;
    left: 48%;
    top: 50%;
    background: #f0f0f0;
    opacity: 0.5;
  }

  .game-thumb--game-of-life {
    background:
      linear-gradient(#242424 1px, transparent 1px) 0 0 / 18px 18px,
      linear-gradient(90deg, #242424 1px, transparent 1px) 0 0 / 18px 18px,
      #111;
  }

  .game-thumb--game-of-life::before {
    width: 12px;
    height: 12px;
    left: 36%;
    top: 36%;
    background: #8fe6ff;
    box-shadow:
      18px 0 0 #8fe6ff,
      36px 0 0 #e8702a,
      18px 18px 0 #8fe6ff,
      36px 18px 0 #8fe6ff,
      54px 36px 0 #e8702a,
      18px 54px 0 #8fe6ff;
  }

  .game-thumb--artificial {
    background:
      linear-gradient(90deg, rgba(232, 112, 42, 0.18), transparent),
      linear-gradient(180deg, #1a1411, #151515);
  }

  .game-thumb--artificial::before {
    width: 72%;
    height: 2px;
    left: 14%;
    top: 52%;
    background: #e8702a;
    box-shadow:
      0 -30px 0 rgba(232, 112, 42, 0.28),
      0 30px 0 rgba(232, 112, 42, 0.18);
  }

  .game-thumb--artificial::after {
    width: 14px;
    height: 14px;
    left: 22%;
    top: 47%;
    border-radius: 999px;
    background: #f0f0f0;
    box-shadow:
      64px 0 0 #e8702a,
      128px 0 0 #8fe6ff,
      192px 0 0 #e8702a;
  }

  .game-thumb--cellular-caves {
    background:
      radial-gradient(
        circle at 22% 50%,
        transparent 0 24px,
        #193f35 25px 48px,
        transparent 49px
      ),
      radial-gradient(
        circle at 63% 34%,
        transparent 0 34px,
        #193f35 35px 62px,
        transparent 63px
      ),
      radial-gradient(
        circle at 74% 72%,
        transparent 0 30px,
        #193f35 31px 58px,
        transparent 59px
      ),
      #0f1614;
  }

  .game-thumb--cellular-caves::before {
    inset: 18px;
    border: 1px solid rgba(143, 230, 255, 0.18);
  }

  .game-thumb--cellular-caves::after {
    width: 36px;
    height: 6px;
    right: 28px;
    bottom: 30px;
    background: #8fe6ff;
    opacity: 0.8;
  }

  .game-thumb--gacha-bot {
    background: linear-gradient(180deg, #101010, #171717);
  }

  .game-thumb--gacha-bot::before {
    width: 70%;
    height: 8px;
    left: 16%;
    top: 30%;
    background: #6a6a6a;
    box-shadow:
      0 20px 0 #e8702a,
      0 40px 0 #6a6a6a,
      0 60px 0 #949494;
  }

  .game-thumb--gacha-bot::after {
    content: '> run pull --rare';
    left: 16%;
    bottom: 24px;
    color: #e8702a;
    font-size: 12px;
    font-weight: 700;
  }

  .game-thumb--clicker-game {
    background: linear-gradient(180deg, #17120f, #151515);
  }

  .game-thumb--clicker-game::before {
    width: 56px;
    height: 56px;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    border-radius: 8px;
    border: 2px solid #e8702a;
    background: rgba(232, 112, 42, 0.12);
  }

  .game-thumb--clicker-game::after {
    width: 34px;
    height: 5px;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    background: #949494;
    box-shadow:
      -42px 0 0 #6a6a6a,
      42px 0 0 #6a6a6a;
  }

  .game-thumb--default {
    background:
      linear-gradient(135deg, rgba(232, 112, 42, 0.2), transparent), #151515;
  }

  #game-player {
    margin-inline: min(0px, calc((72rem - 100vw) / 2));
    padding-inline: clamp(1rem, 2vw, 2rem);
    scroll-margin-top: 5rem;
  }

  .player-actions > a:not(.hidden),
  .player-actions > button:not(.hidden) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 12px;
  }

  .game-stage {
    width: 100%;
    max-width: min(
      100%,
      calc((100vh - 7rem) * var(--game-aspect-value, 1.777)),
      96rem
    );
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid #252525;
    border-radius: 0.75rem;
    background: #000;
  }

  .game-frame {
    display: block;
    width: 100%;
    min-height: 28rem;
    border: 0;
    aspect-ratio: var(--game-aspect, 16 / 9);
  }

  .player-details {
    width: 100%;
    max-width: min(
      100%,
      calc((100vh - 7rem) * var(--game-aspect-value, 1.777)),
      96rem
    );
    margin: 1rem auto 0;
    padding: 1rem 1.25rem;
    border: 1px solid #252525;
    border-radius: 0.75rem;
    background: #151515;
  }

  .game-stage:fullscreen {
    width: 100vw;
    height: 100vh;
    max-width: none;
    border: 0;
    border-radius: 0;
  }

  .game-stage:fullscreen .game-frame {
    width: 100vw;
    height: 100vh;
    min-height: 0;
    aspect-ratio: auto;
  }

  @media (max-width: 48rem) {
    #game-player {
      margin-inline: -1.5rem;
    }

    .game-frame {
      min-height: 22rem;
    }
  }
</style>

<script>
  import { track } from '../lib/track';

  let cleanup: (() => void) | undefined;

  function initializePlayer() {
    cleanup?.();
    const catalog = document.getElementById('game-catalog');
    const intro = document.getElementById('games-intro');
    const player = document.getElementById('game-player');
    const frame = document.querySelector<HTMLIFrameElement>('#player-frame');
    const title = document.getElementById('player-title');
    const description = document.getElementById('player-description');
    const tech = document.getElementById('player-tech');
    const githubLink = document.querySelector<HTMLAnchorElement>('#player-github');
    const downloadLink = document.querySelector<HTMLAnchorElement>('#player-download');
    const downloadLabel = document.getElementById('player-download-label');
    const privateRepo = document.getElementById('player-private');
    const backBtn = document.getElementById('player-back');
    const fullscreenBtn = document.getElementById('player-fullscreen');
    const stage = document.getElementById('player-stage');
    const status = document.getElementById('player-status');
    const retryBtn = document.getElementById('player-retry');
    const directLink = document.querySelector<HTMLAnchorElement>('#player-direct');
    if (!catalog || !player || !frame || !title || !stage || !status) return;

    const controller = new AbortController();
    const options = { signal: controller.signal };
    const cards = [...document.querySelectorAll<HTMLButtonElement>('.game-card')];
    let activeCard: HTMLButtonElement | undefined;
    let loadingTimeout: number | undefined;
    const clearLoading = () => window.clearTimeout(loadingTimeout);
    cleanup = () => {
      controller.abort();
      clearLoading();
    };

    const loadEmbed = (card: HTMLButtonElement) => {
      clearLoading();
      frame.removeAttribute('srcdoc');
      frame.src = card.dataset.gameEmbed || '';
      status.textContent = 'Opening player...';
      loadingTimeout = window.setTimeout(() => {
        status.textContent = 'Taking a while? Retry the player or open it in a new tab.';
      }, 12000);
    };

    frame.addEventListener('load', () => {
      if (!activeCard?.dataset.gameEmbed) return;
      clearLoading();
      // a load event can also mean an error page, so keep recovery available
      status.textContent = 'If the player is blank, retry it or open it in a new tab.';
    }, options);
    frame.addEventListener('error', () => {
      clearLoading();
      status.textContent = 'The player could not load. Retry it or open it in a new tab.';
    }, options);

    const openGame = (card: HTMLButtonElement) => {
      if (activeCard === card) return;
      activeCard = card;
      const embedUrl = card.dataset.gameEmbed;
      track('action_completed', 'game');
      title.textContent = card.dataset.gameTitle || '';
      frame.title = `${card.dataset.gameTitle || 'Game'} player`;
      if (description) description.textContent = card.dataset.gameDescription || '';
      if (tech) tech.textContent = card.dataset.gameTech || '';

      const isPrivate = card.dataset.gamePrivate === 'true';
      privateRepo?.classList.toggle('hidden', !isPrivate);
      githubLink?.classList.toggle('hidden', isPrivate || !card.dataset.gameGithub);
      if (githubLink && card.dataset.gameGithub) githubLink.href = card.dataset.gameGithub;

      downloadLink?.classList.toggle('hidden', !card.dataset.gameDownload);
      if (downloadLink && card.dataset.gameDownload) {
        downloadLink.href = card.dataset.gameDownload;
        if (downloadLabel) {
          downloadLabel.textContent = card.dataset.gameDownload.endsWith('.zip')
            ? 'download desktop ZIP'
            : 'download JAR';
        }
      }

      clearLoading();
      stage.classList.toggle('hidden', !embedUrl);
      retryBtn?.classList.toggle('hidden', !embedUrl);
      directLink?.classList.toggle('hidden', !embedUrl);
      fullscreenBtn?.classList.toggle('hidden', !embedUrl || !document.fullscreenEnabled);
      if (directLink && embedUrl) directLink.href = embedUrl;

      const displayWidth = Number(card.dataset.gameDisplayWidth);
      const displayHeight = Number(card.dataset.gameDisplayHeight);
      if (displayWidth > 0 && displayHeight > 0) {
        stage.style.setProperty('--game-aspect', `${displayWidth} / ${displayHeight}`);
        stage.style.setProperty('--game-aspect-value', String(displayWidth / displayHeight));
      } else {
        stage.style.removeProperty('--game-aspect');
        stage.style.removeProperty('--game-aspect-value');
      }

      if (embedUrl) loadEmbed(card);
      else {
        frame.removeAttribute('src');
        frame.removeAttribute('srcdoc');
        status.textContent = card.dataset.gameNoembed || 'Game embed coming soon';
      }
      catalog.classList.add('hidden');
      intro?.classList.add('hidden');
      player.classList.remove('hidden');
      player.scrollIntoView({ block: 'start' });
      title.focus({ preventScroll: true });
    };

    const closeGame = () => {
      if (!activeCard) return;
      const previousCard = activeCard;
      activeCard = undefined;
      clearLoading();
      player.classList.add('hidden');
      intro?.classList.remove('hidden');
      catalog.classList.remove('hidden');
      frame.removeAttribute('src');
      frame.removeAttribute('srcdoc');
      status.textContent = '';
      previousCard.focus();
    };

    const syncGameFromUrl = () => {
      const id = window.location.hash.slice(1);
      const card = cards.find((candidate) => candidate.dataset.gameId === id);
      if (card) openGame(card);
      else closeGame();
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.gameId;
        if (!id) return;
        window.location.hash = id;
        syncGameFromUrl();
      }, options);
    });
    backBtn?.addEventListener('click', () => {
      window.history.pushState(window.history.state, '', window.location.pathname + window.location.search);
      closeGame();
    }, options);
    retryBtn?.addEventListener('click', () => {
      if (activeCard?.dataset.gameEmbed) loadEmbed(activeCard);
    }, options);
    window.addEventListener('popstate', syncGameFromUrl, options);
    window.addEventListener('hashchange', syncGameFromUrl, options);
    syncGameFromUrl();

    fullscreenBtn?.addEventListener('click', async () => {
      try {
        await stage.requestFullscreen();
      } catch {
        status.textContent = 'Fullscreen is unavailable. You can open the player in a new tab.';
      }
    }, options);
  }

  document.addEventListener('astro:page-load', initializePlayer);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
