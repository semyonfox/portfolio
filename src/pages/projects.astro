---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { selectedProjectIds } from '../data/project-display';
import '../styles/projects.css';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const games = (await getCollection('games')).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectById = new Map(projects.map((project) => [project.id, project]));
const selectedProjects = selectedProjectIds.map((id) => {
  const project = projectById.get(id);
  if (!project) throw new Error(`Selected project is missing: ${id}`);
  return project;
});

const selectedIds = new Set<string>(selectedProjectIds);
const interactiveGames = games.filter((game) => !selectedIds.has(game.id));
const shownIds = new Set([
  ...selectedProjectIds,
  ...interactiveGames.map((game) => game.id),
]);
const remainingProjects = projects.filter((project) => !shownIds.has(project.id));
const personalProjects = remainingProjects.filter(
  (project) => project.data.category === 'personal',
);
const academicProjects = remainingProjects.filter(
  (project) => project.data.category === 'academic',
);

const gameLabel = (id: string) =>
  id === 'gacha-bot'
    ? 'browser script'
    : id === 'inflatr'
      ? 'browser tool'
      : 'playable game';
---

<Layout
  title="Projects | Semyon Fox"
  description="Software, games and interactive projects by Semyon Fox, with working demos and honest project status."
>
  <section id="projects-page" class="pt-20 pb-16 md:pt-28">
    <div class="projects-intro">
      <h1 class="type-page-title mb-3">Projects</h1>
      <p class="type-body mb-4 max-w-2xl">
        I build software for things I use, then keep following the interesting
        problems. The work here spans swimming, study, chess, games and the
        systems that run them.
      </p>
      <p class="text-muted text-sm max-w-2xl">
        Some are deployed. Others are prototypes or experiments, and their
        current limits are part of the write-up.
      </p>
      <div class="project-finder" role="search" aria-label="Find projects">
        <label for="project-search">Find something to explore</label>
        <input id="project-search" type="search" placeholder="Search projects, games or tools" autocomplete="off" />
        <div class="project-filter-list" role="group" aria-label="Filter projects">
          <button type="button" data-project-filter="all" aria-pressed="true">All</button>
          <button type="button" data-project-filter="live" aria-pressed="false">Live sites</button>
          <button type="button" data-project-filter="play" aria-pressed="false">Try in browser</button>
          <button type="button" data-project-filter="download" aria-pressed="false">Downloads</button>
        </div>
        <p id="project-results" class="project-results" aria-live="polite"></p>
      </div>
    </div>

    <section aria-labelledby="selected-work-title" data-project-section>
      <div class="projects-section-heading">
        <h2 id="selected-work-title" class="type-section-title">Selected work</h2>
        <p>Products, games and experiments worth a closer look.</p>
      </div>
      <div class="project-bento-grid">
        {
          selectedProjects.map((project, index) => (
            <article
              id={`project-${project.id}`}
              data-project-item
              data-search={`${project.data.title} ${project.data.description} ${project.data.tags.join(' ')}`.toLowerCase()}
              data-live={project.data.live ? 'true' : 'false'}
              data-play={project.data.demo ? 'true' : 'false'}
              data-download={project.data.downloads.length ? 'true' : 'false'}
              class:list={[
                'project-bento-card',
                `project-bento-${index + 1}`,
                project.data.image && 'has-image',
              ]}
            >
              {project.data.image && (
                <img
                  src={project.data.image}
                  alt=""
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="project-bento-content">
                <p class="project-kicker">
                  {project.data.category === 'academic'
                    ? 'academic project'
                    : 'personal project'}
                </p>
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                <p class="project-bento-description">
                  {project.data.description}
                </p>
                <div class="project-tags">
                  {project.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
                <div class="project-actions">
                  <a href={`/projects/${project.id}`}>details &rarr;</a>
                  {project.data.demo && (
                    <a href={project.data.demo}>play &rarr;</a>
                  )}
                  {project.data.live && (
                    <a
                      href={project.data.live}
                      target="_blank"
                      rel="noopener noreferrer">live site &nearr;</a
                    >
                  )}
                  {project.data.downloads.length > 0 && (
                    <a href={`/projects/${project.id}#project-downloads`}>downloads &darr;</a>
                  )}
                  {project.data.github &&
                    (project.data.private ? (
                      <span>private source</span>
                    ) : (
                      <a
                        href={project.data.github}
                        target="_blank"
                        rel="noopener noreferrer">source &nearr;</a
                      >
                    ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="projects-interactive-work" aria-labelledby="games-title" data-project-section>
      <div class="projects-section-heading">
        <h2 id="games-title" class="type-section-title">
          Games &amp; interactive tools
        </h2>
        <p>Games you can open in a browser, plus a couple of interactive tools.</p>
      </div>
      <div class="project-game-grid">
        {
          interactiveGames.map((game, index) => (
            <article
              id={`game-${game.id}`}
              data-project-item
              data-search={`${game.data.title} ${game.data.description} ${game.data.tech}`.toLowerCase()}
              data-live={game.data.embed?.startsWith('http') ? 'true' : 'false'}
              data-play={game.data.embed ? 'true' : 'false'}
              data-download={game.data.download ? 'true' : 'false'}
              class:list={[
                'project-game-tile',
                `project-game-${index + 1}`,
                game.data.thumbnail && 'has-image',
              ]}
            >
              {game.data.thumbnail && (
                <img
                  src={game.data.thumbnail}
                  alt=""
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="project-game-content">
                <p class="project-kicker">{gameLabel(game.id)}</p>
                <h3>{game.data.title}</h3>
                <p class="project-game-description">{game.data.description}</p>
                <span class="project-game-tech">{game.data.tech}</span>
                <div class="project-actions">
                  {game.data.embed && (
                    <a href={`/games#${game.id}`}>
                      open {game.id === 'inflatr' ? 'tool' : 'game'} &rarr;
                    </a>
                  )}
                  {game.data.download && (
                    <a href={game.data.download} download>
                      download {game.data.download.endsWith('.zip') ? 'desktop ZIP' : 'JAR'} &darr;
                    </a>
                  )}
                  {game.data.github &&
                    !game.data.private && (
                      <a
                        href={game.data.github}
                        target="_blank"
                        rel="noopener noreferrer">source &nearr;</a>
                    )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="projects-more-work" aria-labelledby="more-projects-title" data-project-section>
      <div class="projects-section-heading">
        <h2 id="more-projects-title" class="type-section-title">
          More projects
        </h2>
        <p>Smaller tools, infrastructure and coursework.</p>
      </div>
      {
        [
          { title: 'Personal projects', projects: personalProjects },
          { title: 'Coursework and team projects', projects: academicProjects },
        ].map((group) => (
          <section class="project-plain-section" aria-label={group.title} data-project-group>
            <div class="project-plain-heading">
              <h3>{group.title}</h3>
              <span>{group.projects.length} projects</span>
            </div>
            <div class="project-plain-list">
              {group.projects.map((project) => (
                <article
                  id={`project-${project.id}`}
                  class="project-plain-row"
                  data-project-item
                  data-search={`${project.data.title} ${project.data.description} ${project.data.tags.join(' ')}`.toLowerCase()}
                  data-live={project.data.live ? 'true' : 'false'}
                  data-play={project.data.demo ? 'true' : 'false'}
                  data-download={project.data.downloads.length ? 'true' : 'false'}
                >
                  <div>
                    <h4>
                      <a href={`/projects/${project.id}`}>
                        {project.data.title}
                      </a>
                    </h4>
                    <p>{project.data.description}</p>
                  </div>
                  <div class="project-plain-side">
                    <span>{project.data.tags.slice(0, 2).join(', ')}</span>
                    <div class="project-actions">
                      {project.data.demo && (
                        <a href={project.data.demo}>play &rarr;</a>
                      )}
                      {project.data.live && (
                        <a
                          href={project.data.live}
                          target="_blank"
                          rel="noopener noreferrer">live site &nearr;</a
                        >
                      )}
                      {project.data.downloads.length > 0 && (
                        <a href={`/projects/${project.id}#project-downloads`}>downloads &darr;</a>
                      )}
                      {project.data.github &&
                        (project.data.private ? (
                          <span>private source</span>
                        ) : (
                          <a
                            href={project.data.github}
                            target="_blank"
                            rel="noopener noreferrer">source &nearr;</a
                          >
                        ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </section>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-project-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-project-group]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-project-section]')];
  const results = document.querySelector<HTMLElement>('#project-results');
  let activeFilter = 'all';

  const updateProjects = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let count = 0;
    for (const item of items) {
      const matchesText = item.dataset.search?.includes(query) ?? false;
      const matchesFilter = activeFilter === 'all' || item.dataset[activeFilter] === 'true';
      item.hidden = !(matchesText && matchesFilter);
      if (!item.hidden) count++;
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-project-item]:not([hidden])');
    }
    for (const section of sections) {
      section.hidden = !section.querySelector('[data-project-item]:not([hidden])');
    }
    if (results) results.textContent = `${count} ${count === 1 ? 'result' : 'results'}`;
  };

  search?.addEventListener('input', updateProjects);
  for (const filter of filters) {
    filter.addEventListener('click', () => {
      activeFilter = filter.dataset.projectFilter ?? 'all';
      for (const button of filters) {
        button.setAttribute('aria-pressed', String(button === filter));
      }
      updateProjects();
    });
  }
  updateProjects();
</script>
