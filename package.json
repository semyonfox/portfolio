{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "people:graph": "node --experimental-strip-types scripts/generate-people-graph.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "astro sync && node node_modules/typescript-7/bin/tsc --noEmit",
    "check": "astro sync && vp check && astro check && pnpm run typecheck",
    "deploy": "vp run check && vp run build && echo 'Deploy is handled by Jenkins after pushing main.'"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.2",
    "preact": "^10.29.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
